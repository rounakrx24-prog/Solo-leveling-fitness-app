    function drawHunterCardCanvas() {
      const canvas = document.getElementById('hunter-card-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const prog = XPLevelEngine.calculateProgress(AppState.xp.totalXP);
      const rank = XPLevelEngine.calculateRank(AppState);

      // Background
      const grad = ctx.createLinearGradient(0, 0, 640, 360);
      grad.addColorStop(0, '#05080f');
      grad.addColorStop(1, '#0d1930');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, 640, 360);

      // Subtle Grid
      ctx.strokeStyle = 'rgba(0, 240, 255, 0.06)';
      ctx.lineWidth = 1;
      for (let x = 0; x < 640; x += 32) {
        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, 360); ctx.stroke();
      }
      for (let y = 0; y < 360; y += 32) {
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(640, y); ctx.stroke();
      }

      // Outer Glowing Frame
      ctx.strokeStyle = '#00f0ff';
      ctx.lineWidth = 3;
      ctx.strokeRect(14, 14, 612, 332);

      // Header
      ctx.fillStyle = '#00f0ff';
      ctx.font = 'bold 14px Orbitron, sans-serif';
      ctx.fillText('REAL LIFE LEVELING SYSTEM // HUNTER LICENSE', 34, 48);

      // Player Nickname
      ctx.fillStyle = '#f8fafc';
      ctx.font = '900 32px Orbitron, sans-serif';
      ctx.fillText(AppState.profile.nickname.toUpperCase(), 34, 96);

      // Title
      ctx.fillStyle = '#70d6ff';
      ctx.font = '600 16px Rajdhani, sans-serif';
      ctx.fillText(`TITLE: ${AppState.profile.equippedTitle.toUpperCase()}`, 34, 124);

      // Rank Box
      ctx.fillStyle = 'rgba(0, 240, 255, 0.12)';
      ctx.fillRect(490, 36, 114, 100);
      ctx.strokeStyle = '#00f0ff';
      ctx.lineWidth = 2;
      ctx.strokeRect(490, 36, 114, 100);

      ctx.fillStyle = '#94a3b8';
      ctx.font = 'bold 13px Rajdhani, sans-serif';
      ctx.fillText('RANK', 530, 60);
      ctx.fillStyle = '#00f0ff';
      ctx.font = '900 42px Orbitron, sans-serif';
      ctx.fillText(rank, rank.length > 1 ? 502 : 530, 112);

      // Level & Total XP
      ctx.fillStyle = '#f8fafc';
      ctx.font = 'bold 20px Orbitron, sans-serif';
      ctx.fillText(`LEVEL ${String(prog.level).padStart(2, '0')}`, 34, 174);
      ctx.fillStyle = '#94a3b8';
      ctx.font = '600 16px Rajdhani, sans-serif';
      ctx.fillText(`TOTAL XP: ${prog.totalXP.toLocaleString()}   |   QUESTS CLEARED: ${AppState.history.sessions.reduce((a, b) => a + b.questsCompleted, 0)}`, 185, 173);

      // Skills Bars
      const skills = Object.entries(AppState.skills);
      skills.forEach(([name, data], i) => {
        const col = i % 2;
        const row = Math.floor(i / 2);
        const sx = 34 + col * 292;
        const sy = 212 + row * 42;

        ctx.fillStyle = '#cbd5e1';
        ctx.font = 'bold 14px Rajdhani, sans-serif';
        ctx.fillText(`${name.toUpperCase()} — LV.${data.level}`, sx, sy);

        ctx.fillStyle = '#1e293b';
        ctx.fillRect(sx, sy + 7, 260, 8);
        const pct = Math.min(1, data.xp / (data.level * 120));
        ctx.fillStyle = '#00f0ff';
        ctx.fillRect(sx, sy + 7, Math.max(12, 260 * pct), 8);
      });
    }

