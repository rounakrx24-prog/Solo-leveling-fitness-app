          <!-- Interactive Monthly Calendar -->
          <div class="holo-panel bracket-corners rounded-2xl p-4">
            <div class="flex items-center justify-between mb-3">
              <button onclick="UIState.calendarMonthOffset--; renderApp();" class="px-3 py-1 rounded-lg bg-slate-900 border border-slate-700 text-xs text-cyan-300">«</button>
              <div class="font-display text-sm font-bold text-white uppercase tracking-wider">${monthName}</div>
              <button onclick="UIState.calendarMonthOffset++; renderApp();" class="px-3 py-1 rounded-lg bg-slate-900 border border-slate-700 text-xs text-cyan-300">»</button>
            </div>

