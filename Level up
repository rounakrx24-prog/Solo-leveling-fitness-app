    function showToast(message, tone = 'cyan') {
      const layer = document.getElementById('toast-layer');
      if (!layer) return;
      const borderMap = {
        cyan: 'border-cyan-400/70 text-cyan-200 shadow-[0_0_20px_rgba(0,240,255,0.25)]',
        green: 'border-emerald-400/70 text-emerald-200 shadow-[0_0_20px_rgba(16,185,129,0.25)]',
        warning: 'border-amber-400/70 text-amber-200 shadow-[0_0_20px_rgba(245,158,11,0.25)]'
      };
      const el = document.createElement('div');
      el.className = `pointer-events-auto w-full bg-[#0a101d]/95 backdrop-blur-md border ${borderMap[tone] || borderMap.cyan} rounded-xl px-4 py-3 text-xs font-tech tracking-wider uppercase flex items-center gap-2.5 transition-all duration-300`;
      el.innerHTML = `
        <span class="w-2 h-2 rounded-full ${tone === 'warning' ? 'bg-amber-400' : tone === 'green' ? 'bg-emerald-400' : 'bg-cyan-400'} animate-pulse shrink-0"></span>
        <span class="flex-1 leading-snug">${message}</span>
      `;
      layer.appendChild(el);
      setTimeout(() => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(-8px)';
        setTimeout(() => el.remove(), 300);
      }, 3400);
    }

