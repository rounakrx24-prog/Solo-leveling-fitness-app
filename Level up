          AppState.history.measurements.unshift({
            id: 'meas_' + Date.now(),
            date: DateUtils.todayKey(),
            weightKg: w,
            heightCm: h
          });
        }

        let adjustment = 'Maintained current balanced routine.';
        if (pref === 'Lighter' || sleep.includes('extra rest')) {
          AppState.adaptation.volumeModifier = -1;
          adjustment = 'Adjusted upcoming sessions to lighter recovery-friendly volume.';
        } else if (pref === 'Slightly Progressive') {
          AppState.adaptation.volumeModifier = 1;
          adjustment = 'Applied gradual progression to upcoming main quests.';
        } else {
          AppState.adaptation.volumeModifier = 0;
        }
        AppState.adaptation.lastAdjustmentReason = adjustment;

        const weekSessions = AppState.history.sessions.filter(s => DateUtils.isoWeekKey(new Date(s.date)) === currentWeek);
        const questsCount = weekSessions.reduce((acc, s) => acc + s.questsCompleted, 0);

        const prog = XPLevelEngine.calculateProgress(AppState.xp.totalXP);
        const reward = XPLevelEngine.calculateQuestReward(XPLevelEngine.BASE_QUEST_XP.WeeklyEvaluation, prog.level);

        AppState.history.evaluations.unshift({
          id: 'eval_' + Date.now(),
          weekKey: currentWeek,
          date: DateUtils.todayKey(),
          report: {
            workoutsCount: weekSessions.length,
