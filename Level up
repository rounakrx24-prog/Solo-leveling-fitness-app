  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            void: '#05080f',
            navy: '#0a101d',
            panel: 'rgba(13, 21, 38, 0.85)',
            cyan: {
              electric: '#00f0ff',
              icy: '#70d6ff',
            }
          },
          fontFamily: {
            display: ['Orbitron', 'sans-serif'],
            tech: ['Rajdhani', 'sans-serif'],
            sans: ['Inter', 'sans-serif'],
          }
        }
