    function bindRecoveryForm() {
      const form = document.getElementById('recovery-form');
      if (!form) return;
      form.onsubmit = (e) => {
        e.preventDefault();
        const energy = Number(document.getElementById('rec-energy').value);
        const sleep = Number(document.getElementById('rec-sleep').value);
        const fatigue = Number(document.getElementById('rec-fatigue').value);
        const soreness = Number(document.getElementById('rec-soreness').value);
        const mood = Number(document.getElementById('rec-mood').value);
        const motivation = Number(document.getElementById('rec-motivation').value);

        let status = 'READY';
        if (fatigue >= 4 || soreness >= 4 || (energy <= 2 && sleep <= 2)) {
          status = 'REST RECOMMENDED';
        } else if (fatigue === 3 || soreness === 3 || energy === 3) {
          status = 'MODERATE';
        }

        const today = DateUtils.todayKey();
        AppState.history.recoveryLogs = AppState.history.recoveryLogs.filter(r => r.date !== today);
        AppState.history.recoveryLogs.push({ date: today, energy, sleep, fatigue, soreness, mood, motivation, status });

        if (status === 'REST RECOMMENDED' && !AppState.dailyMission.sessionCompleted) {
          WorkoutGenerator.generateDailyMission(true);
        }

