    function toggleProfileArray(field, value) {
      const arr = AppState.profile[field];
      const idx = arr.indexOf(value);
      if (idx > -1) {
        if (field === 'equipment' && arr.length === 1) return;
        arr.splice(idx, 1);
      } else {
        arr.push(value);
      }
      renderApp();
    }

    function advanceOnboarding() {
      AudioEngine.play('click');
      const step = UIState.onboardingStep;
      if (step === 1) {
        const nick = document.getElementById('ob-nickname')?.value.trim();
        const age = Number(document.getElementById('ob-age')?.value);
        const h = document.getElementById('ob-height')?.value.trim();
        if (!nick) {
          showToast('Please enter a Player Nickname.', 'warning');
          return;
        }
        AppState.profile.nickname = nick;
        AppState.profile.age = age >= 10 && age <= 99 ? age : 16;
        AppState.profile.heightCm = h;
      } else if (step === 3) {
        const avoid = document.getElementById('ob-avoid')?.value.trim() || '';
        AppState.profile.avoidedNotes = avoid;
        if (avoid.toLowerCase().includes('jump')) {
          if (!AppState.profile.avoidedExercises.includes('ex_jumping_jacks')) {
            AppState.profile.avoidedExercises.push('ex_jumping_jacks');
          }
        }
      } else if (step === 4) {
        AppState.profile.allergies = document.getElementById('ob-allergies')?.value.trim() || '';
        AppState.onboarded = true;
        WorkoutGenerator.generateDailyMission(true);
        StorageDB.save();
        SystemActions.evaluateAchievements();
        showToast('PLAYER DATA UPDATED. SYSTEM ONLINE.', 'cyan');
        renderApp();
        return;
      }
      UIState.onboardingStep++;
      renderApp();
    }

