    function renderHistoryTab() {
      const now = new Date();
      const targetDate = new Date(now.getFullYear(), now.getMonth() + UIState.calendarMonthOffset, 1);
      const year = targetDate.getFullYear();
      const month = targetDate.getMonth();
      const monthName = targetDate.toLocaleDateString('en-IN', { month: 'long', year: 'numeric' });

      const firstDayIndex = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();

      const sessionDates = new Set(AppState.history.sessions.map(s => s.date));
      const evalDates = new Set(AppState.history.evaluations.map(e => e.date));
      const achDates = new Set(Object.values(AppState.achievements.unlocked).map(a => a.date));
      const lvlDates = new Set(AppState.history.levelUps.map(l => l.date));

      const selectedDate = UIState.selectedHistoryDate;
      const daySessions = AppState.history.sessions.filter(s => s.date === selectedDate);
      const dayEvals = AppState.history.evaluations.filter(e => e.date === selectedDate);
      const dayRecovery = AppState.history.recoveryLogs.find(r => r.date === selectedDate);

      // Summary stats
      const totalSessions = AppState.history.sessions.length;
      const totalMinutes = AppState.history.sessions.reduce((acc, s) => acc + (s.durationMin || 0), 0);
      const totalQuestsDone = AppState.history.sessions.reduce((acc, s) => acc + (s.questsCompleted || 0), 0);

      let calendarCells = '';
      for (let i = 0; i < firstDayIndex; i++) {
        calendarCells += `<div class="h-10"></div>`;
      }
      for (let d = 1; d <= daysInMonth; d++) {
        const dt = new Date(year, month, d);
        const key = DateUtils.todayKey(dt);
        const dow = DateUtils.dayOfWeekShort(dt);
        const isSelected = key === selectedDate;
        const hasSession = sessionDates.has(key);
        const hasEval = evalDates.has(key);
        const hasAch = achDates.has(key) || lvlDates.has(key);
        const isScheduledRest = !AppState.profile.workoutDays.includes(dow) || AppState.settings.extraRestDates.includes(key);

        calendarCells += `
          <button onclick="UIState.selectedHistoryDate='${key}'; renderApp();" class="h-10 rounded-xl border flex flex-col items-center justify-center relative transition ${isSelected ? 'bg-cyan-500/25 border-cyan-400 text-white' : hasSession ? 'bg-emerald-950/40 border-emerald-500/40 text-emerald-200' : 'bg-[#05080f]/80 border-slate-800/80 text-slate-300'}">
            <span class="font-tech text-xs font-bold">${d}</span>
            <div class="flex gap-0.5 mt-0.5">
              ${hasSession ? `<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>` : ''}
              ${hasEval ? `<span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>` : ''}
              ${hasAch ? `<span class="w-1.5 h-1.5 rounded-full bg-[#00f0ff]"></span>` : ''}
              ${!hasSession && isScheduledRest ? `<span class="w-1 h-1 rounded-full bg-slate-500"></span>` : ''}
            </div>
          </button>
        `;
      }

      return `
        <div class="p-4 space-y-4">
          <!-- Summary Stats -->
          <div class="grid grid-cols-3 gap-2">
            <div class="holo-panel rounded-2xl p-3 text-center">
              <div class="text-[10px] font-tech text-slate-400 uppercase">SESSIONS</div>
              <div class="font-display text-lg font-extrabold text-[#00f0ff] mt-0.5">${totalSessions}</div>
            </div>
            <div class="holo-panel rounded-2xl p-3 text-center">
              <div class="text-[10px] font-tech text-slate-400 uppercase">QUESTS CLEARED</div>
              <div class="font-display text-lg font-extrabold text-white mt-0.5">${totalQuestsDone}</div>
