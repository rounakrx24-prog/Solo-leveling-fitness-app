    const WorkoutGenerator = {
      isTodayRestDay() {
        const today = DateUtils.todayKey();
        const dow = DateUtils.dayOfWeekShort();
        if (AppState.settings.safetyPauseSchedule) return true;
        if (AppState.settings.safetyPauseToday && AppState.settings.safetyPauseDate === today) return true;
        if (AppState.settings.extraRestDates.includes(today)) return true;
        return !AppState.profile.workoutDays.includes(dow);
      },

      getAvailableExercises() {
        const userEq = new Set([...AppState.profile.equipment, 'No Equipment']);
        const avoided = new Set([
          ...AppState.profile.avoidedExercises,
          ...AppState.adaptation.discomfortFlaggedIds
        ]);
        const exp = AppState.profile.experience;

        return ExerciseLibraryDB.filter(ex => {
          if (avoided.has(ex.id)) return false;
          // Must match at least one available equipment item
          const hasEq = ex.equipment.some(eq => userEq.has(eq));
          if (!hasEq) return false;
          // Beginners shouldn't start with Challenging overhead/pullup bar unless selected
          if (exp === 'Beginner' && ex.difficulty === 'Challenging' && AppState.adaptation.volumeModifier <= 0) {
            return false;
          }
          return true;
        });
      },

      generateDailyMission(forceRegenerate = false) {
        const today = DateUtils.todayKey();
        // Preserve existing mission if generated today and not forced
        if (!forceRegenerate && AppState.dailyMission.dateKey === today && AppState.dailyMission.quests.length > 0) {
          return AppState.dailyMission;
        }

        // Preserve already awarded instance IDs if regenerating on the same day to prevent XP exploit
        const preservedAwardedIds = AppState.dailyMission.dateKey === today
          ? [...AppState.dailyMission.completedInstanceIds]
          : [];

        const pool = this.getAvailableExercises();
        const duration = Number(AppState.profile.durationMin) || 30;
        const latestRecovery = AppState.history.recoveryLogs[AppState.history.recoveryLogs.length - 1];
        const lowRecovery = latestRecovery && latestRecovery.date === today && latestRecovery.status === 'REST RECOMMENDED';

        const pickRandom = (arr, fallback) => {
          if (!arr.length) return fallback;
          // Slightly favor favorite exercises
          const favs = arr.filter(e => AppState.adaptation.favoriteExerciseIds.includes(e.id));
          if (favs.length && Math.random() < 0.45) {
            return favs[Math.floor(Math.random() * favs.length)];
          }
          return arr[Math.floor(Math.random() * arr.length)];
        };

        const warmups = pool.filter(e => e.category === 'Warm-up & Mobility');
        const strengths = pool.filter(e => e.category === 'Strength');
        const cardios = pool.filter(e => e.category === 'Cardio');
        const skills = pool.filter(e => e.category === 'Skill Practice');
        const cooldowns = pool.filter(e => e.category === 'Recovery & Cooldown');

        const selected = [];
        const usedIds = new Set();
        const addQuest = (ex, slotType) => {
          if (!ex) return;
          usedIds.add(ex.id);
          // Adjust prescription gently based on adaptive volumeModifier
          let presc = ex.defaultPrescription;
          if (lowRecovery || AppState.adaptation.volumeModifier < 0) {
            presc = presc.replace('3 sets', '2 sets');
          } else if (AppState.adaptation.volumeModifier > 0 && AppState.profile.experience !== 'Beginner') {
            presc = presc.replace('3 sets × 10', '3 sets × 12').replace('3 sets × 8', '3 sets × 10');
          }
          selected.push({
            instanceId: `${today}_${slotType}_${selected.length + 1}`,
            exerciseId: ex.id,
            slotType,
            completed: false,
            skipped: false,
            customPresc: presc
          });
        };

        // 1. Warmup
        addQuest(pickRandom(warmups, ExerciseLibraryDB[0]), 'WARM-UP');

        if (lowRecovery) {
          // Gentle recovery flow if player checked in with low recovery today
          addQuest(pickRandom(warmups.filter(e => !usedIds.has(e.id)), ExerciseLibraryDB[1]), 'MOBILITY');
          addQuest(pickRandom(skills.filter(e => !usedIds.has(e.id)), ExerciseLibraryDB[18]), 'SKILL');
          addQuest(pickRandom(cooldowns, ExerciseLibraryDB[21]), 'COOLDOWN');
        } else {
          // Main blocks scaled by duration (15, 30, 45, 60 min)
          const pushPool = strengths.filter(e => e.pattern.includes('Push') && !usedIds.has(e.id));
          const legPool = strengths.filter(e => (e.pattern.includes('Squat') || e.pattern.includes('Lunge') || e.pattern.includes('Hip') || e.pattern.includes('Step')) && !usedIds.has(e.id));
          const pullPool = strengths.filter(e => e.pattern.includes('Pull') && !usedIds.has(e.id));

          addQuest(pickRandom(pushPool.length ? pushPool : strengths, ExerciseLibraryDB[4]), 'MAIN STRENGTH');
          addQuest(pickRandom(legPool.length ? legPool : strengths.filter(e => !usedIds.has(e.id)), ExerciseLibraryDB[10]), 'MAIN STRENGTH');

          if (duration >= 30) {
            addQuest(pickRandom(pullPool.length ? pullPool : strengths.filter(e => !usedIds.has(e.id)), ExerciseLibraryDB[9]), 'MAIN STRENGTH');
            addQuest(pickRandom(cardios.filter(e => !usedIds.has(e.id)), ExerciseLibraryDB[15]), 'CONDITIONING');
          }
          if (duration >= 45) {
            addQuest(pickRandom(skills.filter(e => !usedIds.has(e.id)), ExerciseLibraryDB[18]), 'SKILL PRACTICE');
          }
          if (duration >= 60) {
            const extraStrength = strengths.filter(e => !usedIds.has(e.id));
            if (extraStrength.length) addQuest(pickRandom(extraStrength, extraStrength[0]), 'BONUS STRENGTH');
          }

          // Cooldown
          addQuest(pickRandom(cooldowns, ExerciseLibraryDB[21]), 'COOLDOWN');
        }

        const titles = lowRecovery
          ? ['PROTOCOL: RESTORATIVE CALIBRATION', 'PROTOCOL: GENTLE MOBILITY FLOW']
          : [
              'PROTOCOL: FULL-BODY VANGUARD CIRCUIT',
              'PROTOCOL: KINETIC FOUNDATION DRILL',
              'PROTOCOL: HUNTER AGILITY & POWER',
              'PROTOCOL: BALANCED SYSTEM CONDITIONING'
            ];

        AppState.dailyMission = {
          dateKey: today,
          title: titles[Math.floor(Math.random() * titles.length)],
          description: lowRecovery
            ? 'Adjusted to a light mobility and breathing session based on your recovery status.'
            : `Tailored ${duration}-minute ${AppState.profile.location.toLowerCase()} protocol matched to your available equipment and skill goals.`,
          estimatedMin: lowRecovery ? 15 : duration,
          quests: selected,
          completedInstanceIds: preservedAwardedIds,
          sessionCompleted: false,
          feedbackSubmitted: false
        };

        StorageDB.save();
        return AppState.dailyMission;
      },

      replaceQuest(instanceId) {
        const idx = AppState.dailyMission.quests.findIndex(q => q.instanceId === instanceId);
        if (idx === -1) return false;
        const target = AppState.dailyMission.quests[idx];
        if (target.completed) {
          showToast('Completed quests cannot be replaced.', 'warning');
          return false;
        }
        const currentEx = getExerciseById(target.exerciseId);
        const usedIds = new Set(AppState.dailyMission.quests.map(q => q.exerciseId));
        const pool = this.getAvailableExercises().filter(e => !usedIds.has(e.id));

        // Prefer same category or explicit alternative
        let candidate = pool.find(e => e.id === currentEx.alternativeId)
          || pool.find(e => e.category === currentEx.category)
          || pool[0];

        if (!candidate) {
          showToast('No alternative exercise available with current equipment filter.', 'warning');
          return false;
        }

        // Keep the exact same instanceId so XP cannot be farmed by replacing
        AppState.dailyMission.quests[idx] = {
          ...target,
          exerciseId: candidate.id,
          customPresc: candidate.defaultPrescription,
          skipped: false
        };
        StorageDB.save();
        AudioEngine.play('click');
        showToast(`QUEST ADAPTED: Swapped to ${candidate.name}.`, 'cyan');
        return true;
      }
    };

    // ============================================================================
    // 9. CORE REWARD & PROGRESSION ACTIONS (WITH EXPLOIT PROTECTION)
    // ============================================================================
    const SystemActions = {
      grantXP(amount, reasonLabel, skillCategory = null) {
        if (amount <= 0) return;
        const beforeProg = XPLevelEngine.calculateProgress(AppState.xp.totalXP);

        AppState.xp.totalXP += amount;
        const currentWeek = DateUtils.isoWeekKey();
        if (AppState.xp.weeklyXPWeekKey !== currentWeek) {
          AppState.xp.weeklyXP = 0;
          AppState.xp.weeklyXPWeekKey = currentWeek;
        }
        AppState.xp.weeklyXP += amount;

        // Grant Skill XP if applicable
        if (skillCategory && AppState.skills[skillCategory]) {
          const sk = AppState.skills[skillCategory];
          sk.xp += Math.round(amount * 0.8);
          const req = sk.level * 120;
          while (sk.xp >= req) {
            sk.xp -= req;
            sk.level += 1;
            showToast(`NEW SKILL PROGRESS DETECTED: ${skillCategory.toUpperCase()} LV.${sk.level}`, 'cyan');
          }
        }

        const afterProg = XPLevelEngine.calculateProgress(AppState.xp.totalXP);
        StorageDB.save();

        triggerXPBurst(`+${amount} XP`, reasonLabel);

        // Multi-level up check
        if (afterProg.level > beforeProg.level) {
          AppState.history.levelUps.push({
            date: DateUtils.todayKey(),
            level: afterProg.level
          });
          StorageDB.save();
          AudioEngine.play('levelup');
          setTimeout(() => showLevelUpModal(beforeProg.level, afterProg.level), 550);
        }

        this.evaluateAchievements();
      },

      completeQuest(instanceId) {
        const quest = AppState.dailyMission.quests.find(q => q.instanceId === instanceId);
        if (!quest) return;

        // Exploit Prevention: Check both flag and persistent daily instance ledger
        if (quest.completed || AppState.dailyMission.completedInstanceIds.includes(instanceId)) {
          showToast('SYSTEM NOTICE: Reward already claimed for this quest instance.', 'warning');
          return;
        }

        const ex = getExerciseById(quest.exerciseId);
        const prog = XPLevelEngine.calculateProgress(AppState.xp.totalXP);
        const baseXP = XPLevelEngine.BASE_QUEST_XP[ex.difficulty] || 50;
        const reward = XPLevelEngine.calculateQuestReward(baseXP, prog.level);

        quest.completed = true;
        quest.skipped = false;
        AppState.dailyMission.completedInstanceIds.push(instanceId);

        if (!AppState.achievements.categoriesCompleted.includes(ex.category)) {
          AppState.achievements.categoriesCompleted.push(ex.category);
        }

        AudioEngine.play('quest');
        this.grantXP(reward.finalXP, `${ex.name} (Base ${reward.baseXP} + Bonus ${reward.bonusXP})`, ex.skill);
        StorageDB.save();
        renderApp();
      },

      finishWorkoutSession(elapsedMinutes = 20) {
        const quests = AppState.dailyMission.quests;
        const completedQuests = quests.filter(q => q.completed);

        if (completedQuests.length === 0) {
          showToast('Complete at least one quest before finishing the session, or use Safety Pause.', 'warning');
          return;
        }

        const prog = XPLevelEngine.calculateProgress(AppState.xp.totalXP);
        let sessionXP = 0;
        const exercisesSummary = completedQuests.map(q => {
          const ex = getExerciseById(q.exerciseId);
          const base = XPLevelEngine.BASE_QUEST_XP[ex.difficulty] || 50;
          const rew = XPLevelEngine.calculateQuestReward(base, prog.level);
          sessionXP += rew.finalXP;
          return { name: ex.name, presc: q.customPresc, xp: rew.finalXP };
        });

        const sessionRecord = {
          id: 'sess_' + Date.now(),
          date: DateUtils.todayKey(),
          title: AppState.dailyMission.title,
          questsCompleted: completedQuests.length,
          totalQuests: quests.length,
          xpEarned: sessionXP,
          durationMin: Math.max(5, Math.round(elapsedMinutes)),
          difficulty: 'Comfortable',
          feedback: '',
          exercisesSummary
        };

        if (!AppState.dailyMission.sessionCompleted) {
          AppState.dailyMission.sessionCompleted = true;
          AppState.history.sessions.unshift(sessionRecord);
          // Consistency Skill XP
          const cons = AppState.skills.Consistency;
          cons.xp += 60;
          if (cons.xp >= cons.level * 120) {
            cons.xp -= cons.level * 120;
            cons.level += 1;
          }
        }

        StorageDB.save();
        AudioEngine.play('levelup');
        showPostWorkoutFeedbackModal(sessionRecord.id);
      },

      evaluateAchievements() {
        const prog = XPLevelEngine.calculateProgress(AppState.xp.totalXP);
        const sessionsCount = AppState.history.sessions.length;
        const maxSkillLevel = Math.max(...Object.values(AppState.skills).map(s => s.level));

        const checks = {
          ach_awakening: AppState.onboarded,
          ach_first_quest: AppState.dailyMission.completedInstanceIds.length >= 1 || sessionsCount >= 1,
          ach_first_session: sessionsCount >= 1,
          ach_technique: AppState.achievements.inspectedExercises.length >= 3,
          ach_explorer: AppState.achievements.categoriesCompleted.length >= 3,
          ach_recovery: AppState.history.recoveryLogs.length >= 3 || AppState.settings.extraRestDates.length >= 1,
          ach_weekly: AppState.history.evaluations.length >= 1,
          ach_level3: prog.level >= 3,
          ach_consistency5: sessionsCount >= 5,
          ach_skill_milestone: maxSkillLevel >= 3,
          ach_level5: prog.level >= 5,
          ach_consistency12: sessionsCount >= 12
        };

        for (const ach of AchievementCatalog) {
          if (checks[ach.id] && !AppState.achievements.unlocked[ach.id]) {
            const currentProg = XPLevelEngine.calculateProgress(AppState.xp.totalXP);
            const reward = XPLevelEngine.calculateQuestReward(ach.baseXP, currentProg.level);
            AppState.achievements.unlocked[ach.id] = {
              date: DateUtils.todayKey(),
              xpAwarded: reward.finalXP
            };
            AppState.xp.totalXP += reward.finalXP;
            AppState.xp.weeklyXP += reward.finalXP;
            StorageDB.save();
            showToast(`ACHIEVEMENT UNLOCKED: ${ach.title} (+${reward.finalXP} XP)`, 'cyan');
          }
        }
      }
    };

