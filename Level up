    function bindPhotoJournalForm() {
      const form = document.getElementById('photo-upload-form');
      if (!form) return;
      form.onsubmit = (e) => {
        e.preventDefault();
        const fileInput = document.getElementById('pj-file');
        const dateVal = document.getElementById('pj-date').value || DateUtils.todayKey();
        const noteVal = document.getElementById('pj-note').value.trim();
        const file = fileInput?.files?.[0];
        if (!file) return;

        // Resize image gently on canvas so local storage remains fast & compact
        const reader = new FileReader();
        reader.onload = (ev) => {
          const img = new Image();
          img.onload = async () => {
            const maxW = 720;
            const scale = Math.min(1, maxW / img.width);
            const canvas = document.createElement('canvas');
            canvas.width = Math.round(img.width * scale);
            canvas.height = Math.round(img.height * scale);
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
            const compressed = canvas.toDataURL('image/jpeg', 0.82);

            await StorageDB.savePhoto({
              id: 'photo_' + Date.now(),
              date: dateVal,
              note: noteVal,
              dataUrl: compressed
            });
            showToast('PRIVATE PHOTO SAVED LOCALLY.', 'cyan');
            await loadPhotosIntoView();
          };
          img.src = ev.target.result;
        };
        reader.readAsDataURL(file);
      };
    }

