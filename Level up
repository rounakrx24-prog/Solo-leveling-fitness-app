      openPhotoDB() {
        return new Promise((resolve, reject) => {
          if (!window.indexedDB) return reject('IndexedDB unavailable');
          const req = indexedDB.open(this.dbName, 1);
          req.onupgradeneeded = (e) => {
            const db = e.target.result;
            if (!db.objectStoreNames.contains(this.storeName)) {
              db.createObjectStore(this.storeName, { keyPath: 'id' });
            }
          };
          req.onsuccess = () => resolve(req.result);
          req.onerror = () => reject(req.error);
        });
      },
      async savePhoto(photoRecord) {
        try {
          const db = await this.openPhotoDB();
          return new Promise((resolve, reject) => {
            const tx = db.transaction(this.storeName, 'readwrite');
            tx.objectStore(this.storeName).put(photoRecord);
            tx.oncomplete = () => resolve(true);
            tx.onerror = () => reject(tx.error);
          });
        } catch (e) {
          // Fallback to localStorage array if IndexedDB restricted
          const list = JSON.parse(localStorage.getItem('RLLS_PHOTOS_FALLBACK') || '[]');
          list.unshift(photoRecord);
          localStorage.setItem('RLLS_PHOTOS_FALLBACK', JSON.stringify(list.slice(0, 12)));
          return true;
        }
      },
      async getAllPhotos() {
        try {
          const db = await this.openPhotoDB();
          return new Promise((resolve) => {
            const tx = db.transaction(this.storeName, 'readonly');
            const req = tx.objectStore(this.storeName).getAll();
            req.onsuccess = () => {
              const items = (req.result || []).sort((a, b) => b.date.localeCompare(a.date));
              resolve(items);
            };
            req.onerror = () => resolve([]);
          });
        } catch (e) {
          return JSON.parse(localStorage.getItem('RLLS_PHOTOS_FALLBACK') || '[]');
        }
      },
