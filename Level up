            wentWell: notes,
            recoverySummary: `${sleep} (${balance})`,
            adjustment,
            summary: `${weekSessions.length} sessions completed. ${adjustment}`
          }
        });

        AudioEngine.play('quest');
        SystemActions.grantXP(reward.finalXP, `Weekly Evaluation (${currentWeek})`, 'Consistency');
        StorageDB.save();
        renderApp();
      };
    }

