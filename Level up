            <div class="font-display text-xs font-bold text-white uppercase">SYSTEM INTERFACE CONTROLS</div>

            <div class="flex items-center justify-between py-1">
              <div>
                <div class="font-semibold text-slate-200">System Sound Effects</div>
                <div class="text-[11px] text-slate-400">Futuristic chimes for quest completion & timers</div>
              </div>
              <button onclick="AppState.settings.soundEnabled=!AppState.settings.soundEnabled; StorageDB.save(); renderApp();" class="px-3.5 py-1.5 rounded-xl font-tech font-bold uppercase ${s.soundEnabled ? 'bg-cyan-500/20 border border-cyan-400 text-[#00f0ff]' : 'bg-slate-900 border border-slate-700 text-slate-400'}">
                ${s.soundEnabled ? 'ON' : 'OFF'}
              </button>
            </div>

            <div class="flex items-center justify-between py-1 border-t border-slate-800">
              <div>
                <div class="font-semibold text-slate-200">Reduced Animation</div>
                <div class="text-[11px] text-slate-400">Disables scanlines & floating burst animations</div>
              </div>
              <button onclick="AppState.settings.reducedAnimation=!AppState.settings.reducedAnimation; applyBodyPreferences(); StorageDB.save(); renderApp();" class="px-3.5 py-1.5 rounded-xl font-tech font-bold uppercase ${s.reducedAnimation ? 'bg-cyan-500/20 border border-cyan-400 text-[#00f0ff]' : 'bg-slate-900 border border-slate-700 text-slate-400'}">
                ${s.reducedAnimation ? 'ON' : 'OFF'}
              </button>
            </div>
          </div>

          <!-- Data Management & Backup -->
          <div class="holo-panel rounded-2xl p-4 space-y-3 text-xs">
            <div class="font-display text-xs font-bold text-white uppercase">LOCAL DATA & BACKUP</div>
            <div class="text-[11px] text-cyan-300">LOCAL MODE — DATA STORED ON THIS DEVICE</div>

            <div class="grid grid-cols-2 gap-2">
              <button onclick="exportBackupJSON()" class="py-2.5 rounded-xl bg-cyan-500/20 border border-cyan-400/50 text-cyan-200 font-tech font-bold uppercase">
                Export JSON Backup
              </button>
              <label class="py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-slate-200 font-tech font-bold uppercase text-center cursor-pointer">
                Import Backup
                <input type="file" accept=".json" onchange="importBackupJSON(event)" class="hidden" />
              </label>
            </div>

            <div class="pt-2 border-t border-slate-800 space-y-2">
              <button onclick="confirmClearHistory()" class="w-full py-2.5 rounded-xl bg-amber-950/40 border border-amber-500/40 text-amber-300 font-tech font-bold uppercase">
                Delete Workout Records (Keep Level & XP)
              </button>
              <button onclick="confirmFactoryReset()" class="w-full py-2.5 rounded-xl bg-rose-950/40 border border-rose-500/40 text-rose-300 font-tech font-bold uppercase">
                Delete All App Data & Reset System
              </button>
            </div>
          </div>
        </div>
      `;
    }

    function toggleSafetyPauseToday() {
      const today = DateUtils.todayKey();
      const currently = AppState.settings.safetyPauseToday && AppState.settings.safetyPauseDate === today;
      AppState.settings.safetyPauseToday = !currently;
      AppState.settings.safetyPauseDate = !currently ? today : '';
      StorageDB.save();
      showToast(!currently ? 'TODAY’S WORKOUT PAUSED — REST WELL.' : 'TRAINING RESUMED.', 'cyan');
      renderApp();
    }

    function toggleSafetyPauseSchedule() {
      AppState.settings.safetyPauseSchedule = !AppState.settings.safetyPauseSchedule;
      StorageDB.save();
      showToast(AppState.settings.safetyPauseSchedule ? 'SCHEDULE PAUSED — ZERO PENALTIES.' : 'TRAINING SCHEDULE ACTIVE.', 'cyan');
      renderApp();
    }

    function addExtraRestToday() {
      const today = DateUtils.todayKey();
      if (!AppState.settings.extraRestDates.includes(today)) {
        AppState.settings.extraRestDates.push(today);
      }
      StorageDB.save();
      SystemActions.evaluateAchievements();
      showToast('RECOVERY DAY REGISTERED.', 'green');
      renderApp();
    }

    function exportBackupJSON() {
      const blob = new Blob([JSON.stringify(AppState, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `RLLS_Backup_${DateUtils.todayKey()}.json`;
      a.click();
      URL.revokeObjectURL(url);
      showToast('SYSTEM BACKUP EXPORTED.', 'cyan');
    }

    function importBackupJSON(event) {
      const file = event.target.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        try {
          const parsed = JSON.parse(e.target.result);
          if (!parsed || typeof parsed !== 'object' || !parsed.profile) {
            throw new Error('Invalid backup format');
          }
          AppState = deepMerge(DefaultState(), parsed);
          StorageDB.save();
          applyBodyPreferences();
          showToast('BACKUP RESTORED SUCCESSFULLY.', 'green');
          renderApp();
        } catch (err) {
          showToast('Invalid backup file selected.', 'warning');
        }
      };
      reader.readAsText(file);
    }

    function confirmClearHistory() {
      openModal(`
        <div class="text-center space-y-3">
          <div class="font-display text-sm font-bold text-amber-300 uppercase">CONFIRM RECORD WIPE</div>
          <p class="text-xs text-slate-300">This will clear your workout session history and logs while keeping your Player Level, XP, and Profile intact.</p>
          <div class="flex gap-2 pt-2">
            <button onclick="closeModal()" class="flex-1 py-2.5 rounded-xl bg-slate-800 text-slate-200 font-tech text-xs font-bold uppercase">Cancel</button>
            <button onclick="AppState.history.sessions=[]; AppState.history.recoveryLogs=[]; StorageDB.save(); closeModal(); showToast('Workout records cleared.', 'cyan'); renderApp();" class="flex-1 py-2.5 rounded-xl bg-amber-500 text-slate-950 font-display text-xs font-bold uppercase">Confirm</button>
          </div>
        </div>
      `);
    }

    function confirmFactoryReset() {
      openModal(`
        <div class="text-center space-y-3">
          <div class="font-display text-sm font-bold text-rose-400 uppercase">FULL SYSTEM RESET</div>
          <p class="text-xs text-slate-300">This permanently deletes all local profile data, XP, levels, achievements, and private photos on this device.</p>
          <div class="flex gap-2 pt-2">
            <button onclick="closeModal()" class="flex-1 py-2.5 rounded-xl bg-slate-800 text-slate-200 font-tech text-xs font-bold uppercase">Cancel</button>
            <button onclick="performFactoryReset()" class="flex-1 py-2.5 rounded-xl bg-rose-500 text-white font-display text-xs font-bold uppercase">Reset All</button>
          </div>
        </div>
      `);
    }

    async function performFactoryReset() {
      localStorage.removeItem(STORAGE_KEY);
      await StorageDB.deleteAllPhotos();
      AppState = DefaultState();
      UIState.onboardingStep = 1;
      UIState.activeTab = 'SYSTEM';
      UIState.playerSubView = 'HUB';
      closeModal();
      renderApp();
    }

    // ============================================================================
    // 17. BOTTOM NAVIGATION BAR & MAIN RENDER PIPELINE
    // ============================================================================
    function renderBottomNav() {
      const tabs = [
        {
          id: 'SYSTEM',
          label: 'SYSTEM',
          icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 21 7 21 17 12 22 3 17 3 7 12 2"/><circle cx="12" cy="12" r="3"/></svg>`
        },
        {
          id: 'QUESTS',
          label: 'QUESTS',
          icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>`
        },
        {
          id: 'SKILLS',
          label: 'SKILLS',
          icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="5" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M12 7.5V12m0 0l-5 4m5-4l5 4"/></svg>`
        },
        {
          id: 'HISTORY',
          label: 'HISTORY',
          icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`
        },
        {
          id: 'PLAYER',
          label: 'PLAYER',
          icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`
        }
      ];

      return `
        <nav class="fixed bottom-0 left-1/2 -translate-x-1/2 w-full max-w-lg z-30 bg-[#05080f]/95 backdrop-blur-md border-t border-cyan-500/30 px-2 py-2">
          <div class="grid grid-cols-5 gap-1">
            ${tabs.map(t => {
              const active = UIState.activeTab === t.id;
              return `
                <button onclick="switchTab('${t.id}')" class="flex flex-col items-center justify-center py-1.5 rounded-xl transition ${active ? 'bg-cyan-500/15 text-[#00f0ff] border border-cyan-400/40 shadow-[0_0_12px_rgba(0,240,255,0.2)]' : 'text-slate-400 hover:text-slate-200'}">
                  ${t.icon}
                  <span class="font-tech text-[10px] font-bold tracking-widest mt-1">${t.label}</span>
                </button>
              `;
            }).join('')}
          </div>
        </nav>
      `;
    }

    function switchTab(tabId) {
      AudioEngine.play('click');
      UIState.activeTab = tabId;
      if (tabId === 'PLAYER') UIState.playerSubView = 'HUB';
      renderApp();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function applyBodyPreferences() {
      if (AppState.settings.reducedAnimation) {
        document.body.classList.add('reduced-motion');
      } else {
        document.body.classList.remove('reduced-motion');
      }
    }

    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function renderApp() {
      const root = document.getElementById('app');
      if (!root) return;

      if (!AppState.onboarded) {
        root.innerHTML = renderOnboarding();
        return;
      }

      let mainContent = '';
      switch (UIState.activeTab) {
        case 'SYSTEM':
          mainContent = renderSystemDashboard();
          break;
        case 'QUESTS':
          mainContent = renderQuestsTab();
          break;
        case 'SKILLS':
          mainContent = renderSkillsTab();
          break;
        case 'HISTORY':
          mainContent = renderHistoryTab();
          break;
        case 'PLAYER':
          mainContent = renderPlayerTab();
          break;
      }

      root.innerHTML = `
        <main class="flex-1">
          ${mainContent}
        </main>
        ${renderBottomNav()}
      `;

      // Post-render bindings for sub-views
      if (UIState.activeTab === 'PLAYER') {
        if (UIState.playerSubView === 'PROFILE') drawHunterCardCanvas();
        if (UIState.playerSubView === 'RECOVERY') bindRecoveryForm();
        if (UIState.playerSubView === 'WEEKLY_EVAL') bindWeeklyEvalForm();
        if (UIState.playerSubView === 'PHOTOS') bindPhotoJournalForm();
      }
    }

    // Boot Sequence
    window.addEventListener('DOMContentLoaded', () => {
      StorageDB.load();
      applyBodyPreferences();
      if (AppState.onboarded) {
        WorkoutGenerator.generateDailyMission(false);
        SystemActions.evaluateAchievements();
      }
      renderApp();
    });
  </script>
</body>
</html>
