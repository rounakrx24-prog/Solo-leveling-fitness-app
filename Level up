    function startActiveWorkout() {
      AudioEngine.play('click');
      UIState.activeWorkout.running = true;
      UIState.activeWorkout.paused = false;
      UIState.activeWorkout.sessionSeconds = 0;
      UIState.activeWorkout.activeQuestIdx = 0;
      renderApp();
    }

    function startRestTimer(sec) {
      AudioEngine.play('click');
      if (!UIState.activeWorkout.running) UIState.activeWorkout.running = true;
      UIState.activeWorkout.paused = false;
      UIState.activeWorkout.restRemaining = sec;
      UIState.activeWorkout.restTotal = sec;
      renderApp();
    }

    function startExerciseTimer(sec) {
      AudioEngine.play('click');
      if (!UIState.activeWorkout.running) UIState.activeWorkout.running = true;
      UIState.activeWorkout.paused = false;
      UIState.activeWorkout.exerciseRemaining = sec;
      UIState.activeWorkout.exerciseTotal = sec;
      renderApp();
    }

    function skipQuest(instanceId) {
      const q = AppState.dailyMission.quests.find(item => item.instanceId === instanceId);
      if (q) {
        q.skipped = true;
        StorageDB.save();
        showToast('Quest skipped — zero penalty applied.', 'cyan');
        renderApp();
      }
    }

    function completeQuestAndAdvance(instanceId, idx, restSec) {
      SystemActions.completeQuest(instanceId);
      if (UIState.activeWorkout.running) {
        UIState.activeWorkout.activeQuestIdx = Math.min(AppState.dailyMission.quests.length - 1, idx + 1);
        UIState.activeWorkout.restRemaining = restSec || 60;
      }
      renderApp();
    }

